{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "desk-backtest",
  "strategy": "DeskSwing",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 1.0,
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "spot",
  "cancel_open_orders_on_exit": false,
  "custom_price_max_distance_ratio": 0.3,
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": false,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": false,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT",
      "SOL/USDT",
      "BNB/USDT",
      "XRP/USDT",
      "DOGE/USDT",
      "ADA/USDT",
      "AVAX/USDT",
      "LINK/USDT",
      "DOT/USDT",
      "LTC/USDT",
      "NEAR/USDT",
      "TRX/USDT",
      "BCH/USDT",
      "UNI/USDT",
      "AAVE/USDT",
      "ATOM/USDT",
      "SUI/USDT",
      "APT/USDT",
      "ARB/USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "dataformat_ohlcv": "feather",
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 5
  }
}
