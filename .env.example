# Copy to .env (never committed) and fill in. The agent never reads .env (decision 2).
# docker compose passes this file to the api container only; the desk never sees a key.

# The desk opens on http://127.0.0.1:<DESK_PORT>; change it if another app uses the port.
DESK_PORT=5180

# 1 runs the desk on made-up data, with no keys and nothing real: no Binance, Taostats or Claude.
DEMO=0

# The stablecoin every pair on the Trade page is quoted in: USDC, USDT or FDUSD.
DESK_QUOTE=USDC
# Average cost counts trades from this date, Sydney time (decision 34). Default: 2026-07-01.
DESK_COST_FROM=2026-07-01

# Binance key: read and spot trading only, no withdrawal, restricted to your IP address (spec 10).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# TAO wallet, read-only (decision 17): your coldkey's public address and a Taostats API key.
# Leave TAO_COLDKEY empty to show Binance only.
TAO_COLDKEY=
TAOSTATS_API_KEY=

# AI signals (decision 16): an Anthropic API key, and the most the desk may spend on it each
# month in US dollars. Set a spend limit in the Anthropic Console too.
ANTHROPIC_API_KEY=
# Only for a key that isn't scoped to one workspace: the workspace's ID (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
AI_MONTHLY_CAP_USD=20
